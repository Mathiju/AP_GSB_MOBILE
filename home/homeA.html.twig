<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accueil</title>
    <style>
        /* Styles généraux */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-image: url('https://next-images.123rf.com/index/_next/image/?url=https://assets-cdn.123rf.com/index/static/assets/top-section-bg.jpeg&w=3840&q=75');
            background-size: cover;
            color: #fff;
        }

        /* En-tête */
        header {
            display: flex;
            justify-content: space-between; /* Aligner l'image à gauche et le bouton à droite */
            align-items: center;
            background: linear-gradient(to right, rgba(18, 120, 236, 0.31), rgba(182, 39, 99, 0.51));
            padding: 20px; /* Augmente l'espace intérieur */
            height: 50px;
        }

        header .logo {
            width: 50px; /* Ajuste la taille de l'image */
            height: auto;
            margin-right: 20px; /* Espace entre l'image et les autres éléments */
        }

        .logout:hover {
            background-color:rgba(177, 178, 233, 0.48); /* Rouge */
        }

        header .logout {
            background-color: rgba(111, 112, 177, 0.48); /* Gris foncé */
            border-color: #6c757d; /* Bordure gris foncé */
            border: none;
            padding: 10px 15px;
            color:rgb(255, 255, 255);
            cursor: pointer;
            font-weight: bold;
            font-size: 1.2rem; /* Agrandit le texte */
            text-decoration: none;
            border-radius: 20px;
        }

        .container {
            justify-content: center;
            align-items: center;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            background: rgba(50, 50, 50, 0.2);
            margin: 20px auto; /* Centrer horizontalement */
            width: 1000px; /* Ajuste la largeur au contenu */
            max-width: 90%; /* Limite la largeur maximale */
            backdrop-filter: blur(10px); /* Ajoute un effet de flou */
        }

        .box {
            width: 1000px;
            height: 250px;
            background-color:rgba(255, 255, 255, 0.42);
            color: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 1.2em;
            font-weight: bold;
            padding: 20px; /* Ajoute de l'espace à l'intérieur de la boîte */
            box-sizing: border-box;
            border-radius: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            border: 1px solid #000;
            padding: 8px;
            text-align: center;
            background-color: #f2f2f2;
        }

        th {
            background-color:rgb(192, 192, 192);
        }

        /* Pied de page */
        footer {
            position: fixed;
            bottom: 0;
            left: 0;
            padding: 10px;
            color: #fff;
            font-size: 0.9em;
        }

        /* Style des boutons */
        .btn {
            padding: 5px 10px;
            margin: 5px;
            cursor: pointer;
            border-radius: 5px;
            border: none;
        }

        .btn-add {
            background-color: rgb(93, 161, 101);
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
            border-radius: 10px;
        }
        .btn-add:hover {
            background-color: rgb(134, 209, 143);
        }
        .btn-approve {
            background-color: rgb(93, 161, 101);
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
            border-radius: 10px;
        }
        .btn-approve:hover {
            background-color: rgb(134, 209, 143);
        }
        .btn-reject:hover {
            background-color: rgb(196, 122, 122);
        }
        .btn-reject {
            background-color: rgb(161, 93, 93);
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <header>
        <img src="https://img.freepik.com/vecteurs-libre/ordinateur-bureau-vconcept-illustration_114360-12153.jpg?ga=GA1.1.840802286.1729083279&semt=ais_hybrid" alt="Logo" class="logo" style="width: 80px; height: auto; border-radius: 50%;"> <!-- Ajoutez votre image ici -->
        <a href="#" id="logout" class="logout">Se déconnecter</a>
        <script>
            document.getElementById('logout').addEventListener('click', function(event) {
                event.preventDefault(); // Empêche le comportement par défaut du lien
                window.location.href = 'login'; // Redirige vers la route de login
            });
        </script>
    </header>

    <div class="container">
        <h1>Appuyez sur le bouton pour ajouter un utilisateur.</h1>
        <button class="btn btn-add" onclick="window.location.href='add'">Ajouter</button>
    </div>

    <p style="text-align: center; font-size: 1.5em;">Liste des utilisateurs :</p>
    <div class="container" style="display: flex; justify-content: flex-start; gap: 20px;">
        <div>
            <img src="https://us.123rf.com/450wm/flatdesign/flatdesign2009/flatdesign200900117/154641062-ic%C3%B4ne-de-groupe-de-personnes-conception-de-sites-web-vectoriels.jpg?ver=6" alt="Image" style="width: 100px; height: auto; border-radius: 10px;">
            <div class="box" style="width: 150px; height: 150px;">
                Informations user
            </div>
            <button class="btn btn-approve" onclick="window.location.href='edit'">Modifier</button>
            <button class="btn btn-reject" onclick="window.location.href='delete'">Supprimer</button>
        </div>
        <div>
            <img src="https://us.123rf.com/450wm/flatdesign/flatdesign2009/flatdesign200900117/154641062-ic%C3%B4ne-de-groupe-de-personnes-conception-de-sites-web-vectoriels.jpg?ver=6" alt="Image" style="width: 100px; height: auto; border-radius: 10px;">
            <div class="box" style="width: 150px; height: 150px;">
                Informations user
            </div>
            <button class="btn btn-approve" onclick="window.location.href='edit'">Modifier</button>
            <button class="btn btn-reject" onclick="window.location.href='delete'">Supprimer</button>
        </div>
    </div>

    
</body>
</html>
